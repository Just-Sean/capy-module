.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
dist/

# Test coverage output (uv run pytest --cov).
.coverage
.coverage.*
htmlcov/
coverage.xml

# Secrets and keys never go in git: settings come from the environment. The one
# exception is a committed example with placeholder values.
.env
.env.*
!.env.example
*.pem
*.key

# Local databases and uploads from trying the module out.
*.sqlite3
db.sqlite3*
media/
