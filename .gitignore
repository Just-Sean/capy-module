# The starter repo's own ignores (new modules get template/.gitignore).
.venv/
__pycache__/
*.py[cod]
dist/
.coverage
.coverage.*
*.sqlite3*

# Secrets and keys never go in git. `copier copy --vcs-ref=HEAD` also copies files
# that aren't committed, so anything not ignored here could end up in a new module.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
.envrc
id_rsa*
id_ecdsa*
id_ed25519*
!id_*.pub
